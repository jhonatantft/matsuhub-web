# Public URL of the site, used for canonical/OG URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (Project Settings → API). Server only.
SUPABASE_URL=

# Supabase service_role key — server only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Abuse protection (docs/security.md). All server only.
# Upstash Redis / Vercel KV REST credentials: shared rate limits and duplicate guard across
# instances. Without them the limits are per instance (best-effort). Either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Key of the HMAC applied to client IPs (limiter keys, leads.ip_hash). `openssl rand -hex 32`.
# Falls back to SUPABASE_SERVICE_ROLE_KEY. Changing it restarts every per-IP history.
IP_HASH_SECRET=
