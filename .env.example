# Public URL of the site, used for canonical/OG URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (Project Settings → API). Server only.
SUPABASE_URL=

# Supabase service_role key — server only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# New-lead e-mail (lib/notify/lead-email.ts, via resend.com). Server only.
# Without a verified domain, Resend only delivers to the e-mail of the Resend account itself.
RESEND_API_KEY=
# Who gets the e-mail; several addresses separated by commas.
LEAD_NOTIFY_TO=
# Optional, once matsuhub.com is verified in Resend: MatsuHub <leads@matsuhub.com>
LEAD_NOTIFY_FROM=

# Cloudflare Turnstile (lib/guard/turnstile.ts, components/ui/Turnstile.tsx): proves a lead came
# from a real browser. Off while empty. The site key is public (build time: redeploy after a
# change); the secret is server only. Local test keys that always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Abuse protection (docs/security.md). All server only.
# Upstash Redis / Vercel KV REST credentials: shared rate limits and duplicate guard across
# instances. Without them the limits are per instance (best-effort). Either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Key of the HMAC applied to client IPs (limiter keys, leads.ip_hash). `openssl rand -hex 32`.
# Falls back to SUPABASE_SERVICE_ROLE_KEY. Changing it restarts every per-IP history.
IP_HASH_SECRET=
